# Скопировать в .env и заполнить: cp .env.example .env
# .env в .gitignore, секреты только здесь.

# ---------- Общее ----------
# Часовой пояс для расписаний (уборка, дайджест, напоминания, день/ночь для ttl)
TZ=Europe/Kyiv
# UID:GID, от имени которого работают контейнеры (владелец папки data/). Узнать: id -u; id -g
PUID=1000
PGID=1000

# ---------- Telegram (этап 2) ----------
TELEGRAM_TOKEN=
# Единственный пользователь, которому бот отвечает
ALLOWED_USER_ID=

# ---------- Движок моделей (llama-swap + llama.cpp) ----------
# Образ: legacy-тег :cuda собран на CUDA 12.8 с sm_61 (Pascal) через PTX. Нужен драйвер >= 570.
# Если check-gpu.sh не видит Tesla P4 в этом образе — собрать свой: LLM_IMAGE=notes-llm:pascal
# и docker compose build llm (см. llm/Dockerfile, CUDA 12.4, sm_61, нужен драйвер >= 550).
LLM_IMAGE=ghcr.io/mostlygeek/llama-swap:cuda
# Порт llama-swap на хосте (слушает только 127.0.0.1)
LLM_PORT=9292
# Лимит ОЗУ контейнера с моделями
LLM_MEM_LIMIT=3g
# Папка с GGUF внутри data/
MODELS_DIR=./data/models

# Выгрузка модели после простоя, секунды. Днём (08:00–23:00) / ночью.
# llama-swap умеет только один ttl на модель — в конфиг идёт дневной,
# ночной режим реализует бот (этап 2): через LLM_TTL_NIGHT сек простоя зовёт /api/models/unload.
LLM_TTL_DAY=600
LLM_TTL_NIGHT=60
LLM_DAY_START=08:00
LLM_DAY_END=23:00
# Сколько ждать загрузки модели в VRAM (первая загрузка с JIT-компиляцией PTX может быть долгой)
LLM_HEALTH_TIMEOUT=300

# --- Рутинная модель: очистка, разметка, факты (thinking выключен) ---
ROUTINE_MODEL_NAME=routine
ROUTINE_MODEL_REPO=unsloth/Qwen3.5-4B-GGUF
ROUTINE_MODEL_FILE=Qwen3.5-4B-Q4_K_M.gguf
ROUTINE_CTX=8192

# --- Модель для ответов: /ask, ночная уборка, обзоры ---
ANSWER_MODEL_NAME=answer
ANSWER_MODEL_REPO=unsloth/Qwen3.5-9B-GGUF
ANSWER_MODEL_FILE=Qwen3.5-9B-Q4_K_M.gguf
ANSWER_CTX=12288
# KV-кэш q8_0 (вместе с flash attention)
ANSWER_KV_TYPE=q8_0
# Включать thinking для /ask (1/0). Передаётся ботом в chat_template_kwargs запроса.
ASK_THINKING=0

# --- Черновик для speculative decoding (этап 7, по умолчанию не качается) ---
DRAFT_MODEL_REPO=unsloth/Qwen3.5-0.8B-GGUF
DRAFT_MODEL_FILE=Qwen3.5-0.8B-Q4_K_M.gguf
DOWNLOAD_DRAFT=0

# --- Эмбеддинги ---
EMBED_MODEL_NAME=embed
EMBED_MODEL_REPO=ggml-org/bge-m3-Q8_0-GGUF
EMBED_MODEL_FILE=bge-m3-q8_0.gguf
EMBED_CTX=8192
EMBED_DIM=1024
# На CPU, чтобы не будить GPU ради одного эмбеддинга.
# CPU:  EMBED_CUDA_VISIBLE=-1  EMBED_NGL=0  (процесс вообще не видит видеокарту, 0 МБ VRAM)
# GPU:  EMBED_CUDA_VISIBLE=0   EMBED_NGL=99
EMBED_CUDA_VISIBLE=-1
EMBED_NGL=0
# Потоки CPU для эмбеддингов (из 6 ядер)
EMBED_THREADS=4
# Эмбеддинг-сервер тоже выгружается по простою (экономия ОЗУ в простое)
EMBED_TTL=900
