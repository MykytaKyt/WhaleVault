# Copy to .env and fill in: cp .env.example .env
# .env is git-ignored; secrets live only there.

# ---------- General ----------
# Time zone for schedules (cleanup, digest, reminders, day/night ttl)
TZ=Europe/Kyiv
# UID:GID the containers run as (owner of data/). Find out with: id -u; id -g
PUID=1000
PGID=1000

# ---------- Telegram (stage 2) ----------
TELEGRAM_TOKEN=
# The only user the bot answers
ALLOWED_USER_ID=

# ---------- Model engine (llama-swap + llama.cpp) ----------
# Image: the legacy :cuda tag is built on CUDA 12.8 with sm_61 (Pascal) as PTX. Requires driver >= 570.
# If check-gpu.sh can't see the Tesla P4 in this image, build our own: LLM_IMAGE=notes-llm:pascal
# and docker compose build llm (see llm/Dockerfile, CUDA 12.4, sm_61, requires driver >= 550).
LLM_IMAGE=ghcr.io/mostlygeek/llama-swap:cuda
# llama-swap port on the host (bound to 127.0.0.1 only)
LLM_PORT=9292
# RAM limit for the model container
LLM_MEM_LIMIT=3g
# GGUF directory inside data/
MODELS_DIR=./data/models

# Unload a model after this many idle seconds. Daytime (08:00–23:00) / night.
# llama-swap supports only one ttl per model, so the config uses the daytime value;
# night mode is handled by the bot (stage 2): after LLM_TTL_NIGHT idle seconds it calls /api/models/unload.
LLM_TTL_DAY=600
LLM_TTL_NIGHT=60
LLM_DAY_START=08:00
LLM_DAY_END=23:00
# How long to wait for a model to load into VRAM (the first load JIT-compiles PTX and can be slow)
LLM_HEALTH_TIMEOUT=300

# --- Routine model: cleanup, tagging, facts (thinking off) ---
ROUTINE_MODEL_NAME=routine
ROUTINE_MODEL_REPO=unsloth/Qwen3.5-4B-GGUF
ROUTINE_MODEL_FILE=Qwen3.5-4B-Q4_K_M.gguf
ROUTINE_CTX=8192

# --- Answer model: /ask, nightly cleanup, overviews ---
ANSWER_MODEL_NAME=answer
ANSWER_MODEL_REPO=unsloth/Qwen3.5-9B-GGUF
ANSWER_MODEL_FILE=Qwen3.5-9B-Q4_K_M.gguf
ANSWER_CTX=12288
# KV cache type q8_0 (together with flash attention)
ANSWER_KV_TYPE=q8_0
# Enable thinking for /ask (1/0). The bot passes it in the request's chat_template_kwargs.
ASK_THINKING=0

# --- Draft model for speculative decoding (stage 7, not downloaded by default) ---
DRAFT_MODEL_REPO=unsloth/Qwen3.5-0.8B-GGUF
DRAFT_MODEL_FILE=Qwen3.5-0.8B-Q4_K_M.gguf
DOWNLOAD_DRAFT=0

# --- Embeddings ---
EMBED_MODEL_NAME=embed
EMBED_MODEL_REPO=ggml-org/bge-m3-Q8_0-GGUF
EMBED_MODEL_FILE=bge-m3-q8_0.gguf
EMBED_CTX=8192
EMBED_DIM=1024
# On CPU, so a single embedding never wakes the GPU.
# CPU:  EMBED_CUDA_VISIBLE=-1  EMBED_NGL=0  (the process can't see the GPU at all, 0 MB VRAM)
# GPU:  EMBED_CUDA_VISIBLE=0   EMBED_NGL=99
EMBED_CUDA_VISIBLE=-1
EMBED_NGL=0
# CPU threads for embeddings (out of 6 cores)
EMBED_THREADS=4
# The embedding server is also unloaded when idle (saves RAM)
EMBED_TTL=900
